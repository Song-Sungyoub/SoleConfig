<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Package Name="SoleConfig" Manufacturer="SoleConfig" Version="$(var.ProductVersion)" UpgradeCode="4F188516-2CA0-4F77-9B39-823C11A772E3" Scope="perUser" Language="1042" Codepage="949">
  <MajorUpgrade DowngradeErrorMessage="더 최신 버전의 SoleConfig가 이미 설치되어 있습니다." />
  <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
  <Icon Id="AppIcon" SourceFile="$(var.ProjectRoot)\Assets\Icon\SoleConfig.ico" />
  <Binary Id="AppIcon" SourceFile="$(var.ProjectRoot)\Assets\Icon\SoleConfig.ico" />
  <Property Id="ARPPRODUCTICON" Value="AppIcon" />
  <Property Id="ARPNOMODIFY" Value="1" />
  <Property Id="LAUNCHAPP" Value="1" />
  <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="SoleConfig" /></Directory></StandardDirectory>
  <StandardDirectory Id="ProgramMenuFolder"><Directory Id="MenuFolder" Name="SoleConfig" /></StandardDirectory>
  <Feature Id="MainFeature" Title="SoleConfig" Level="1"><ComponentGroupRef Id="Payload"/><ComponentRef Id="MenuShortcut"/><ComponentRef Id="FileAssociations"/></Feature>
  <Component Id="MenuShortcut" Directory="MenuFolder" Guid="4A73B162-63BE-4F32-9E41-3D41091CB30C">
   <Shortcut Id="MenuLink" Name="SoleConfig" Target="[INSTALLFOLDER]SoleConfig.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
   <RemoveFolder Id="RemoveMenuFolder" On="uninstall"/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
  </Component>
  <Component Id="FileAssociations" Directory="INSTALLFOLDER" Guid="C8E2E524-47AC-41B5-A617-7BA8A0DCA292">
   <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="SoleConfig" Type="string" Value="Software\SoleConfig\Capabilities" KeyPath="yes"/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities" Name="ApplicationName" Type="string" Value="SoleConfig"/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities" Name="ApplicationDescription" Type="string" Value="JSON, XML, CSV, YAML, INI 설정 편집기"/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities" Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]SoleConfig.exe,0"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\SoleConfig.Document" Type="string" Value="SoleConfig 설정 파일"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\SoleConfig.Document\DefaultIcon" Type="string" Value="[INSTALLFOLDER]SoleConfig.exe,0"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\SoleConfig.Document\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]SoleConfig.exe&quot; &quot;%1&quot;"/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities\FileAssociations" Name=".json" Type="string" Value="SoleConfig.Document"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.json\OpenWithProgids" Name="SoleConfig.Document" Type="string" Value=""/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities\FileAssociations" Name=".xml" Type="string" Value="SoleConfig.Document"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.xml\OpenWithProgids" Name="SoleConfig.Document" Type="string" Value=""/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities\FileAssociations" Name=".csv" Type="string" Value="SoleConfig.Document"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.csv\OpenWithProgids" Name="SoleConfig.Document" Type="string" Value=""/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities\FileAssociations" Name=".yaml" Type="string" Value="SoleConfig.Document"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.yaml\OpenWithProgids" Name="SoleConfig.Document" Type="string" Value=""/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities\FileAssociations" Name=".yml" Type="string" Value="SoleConfig.Document"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.yml\OpenWithProgids" Name="SoleConfig.Document" Type="string" Value=""/>
   <RegistryValue Root="HKCU" Key="Software\SoleConfig\Capabilities\FileAssociations" Name=".ini" Type="string" Value="SoleConfig.Document"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.ini\OpenWithProgids" Name="SoleConfig.Document" Type="string" Value=""/>
  </Component>
  <CustomAction Id="LaunchApp" FileRef="AppExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes"/>
  <CustomAction Id="OpenDefaultApps" FileRef="AppExe" ExeCommand="--default-apps" Return="asyncNoWait" Impersonate="yes"/>
  <UI>
   <TextStyle Id="Normal" FaceName="맑은 고딕" Size="9"/>
   <TextStyle Id="Heading" FaceName="맑은 고딕" Size="16" Bold="yes"/>
   <Property Id="DefaultUIFont" Value="Normal"/>
   <UIRef Id="WixUI_Common"/>
   <DialogRef Id="FatalError"/><DialogRef Id="UserExit"/><DialogRef Id="ErrorDlg"/><DialogRef Id="FilesInUse"/><DialogRef Id="MsiRMFilesInUse"/>
   <Dialog Id="Welcome" Width="390" Height="280" Title="SoleConfig 설치">
    <Control Id="Icon" Type="Icon" X="22" Y="22" Width="40" Height="40" Text="AppIcon" FixedSize="yes" IconSize="48"/>
    <Control Id="Title" Type="Text" X="78" Y="26" Width="290" Height="30" Text="{\Heading}SoleConfig 설치"/>
    <Control Id="Body" Type="Text" X="24" Y="85" Width="342" Height="90" Text="JSON · XML · CSV · YAML · INI 설정 편집기입니다.&#13;&#10;&#13;&#10;현재 사용자 계정에 설치하고 시작 메뉴에 바로가기를 추가합니다. .NET 런타임이 포함되어 있습니다."/>
    <Control Id="Location" Type="Text" X="24" Y="181" Width="342" Height="35" Text="설치 위치: [INSTALLFOLDER]"/>
    <Control Id="Line" Type="Line" X="0" Y="235" Width="390" Height="0"/>
    <Control Id="Install" Type="PushButton" X="240" Y="250" Width="65" Height="20" Default="yes" Text="설치"><Publish Event="EndDialog" Value="Return"/></Control>
    <Control Id="Cancel" Type="PushButton" X="315" Y="250" Width="60" Height="20" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit"/></Control>
   </Dialog>
   <Dialog Id="Installing" Width="390" Height="280" Title="SoleConfig 설치" Modeless="yes">
    <Control Id="Title" Type="Text" X="24" Y="28" Width="340" Height="30" Text="{\Heading}설치 중입니다" TabSkip="no"/>
    <Control Id="Body" Type="Text" X="24" Y="90" Width="340" Height="35" Text="완료될 때까지 잠시 기다려 주세요."/>
    <Control Id="Progress" Type="ProgressBar" X="24" Y="142" Width="340" Height="15" ProgressBlocks="yes"><Subscribe Event="SetProgress" Attribute="Progress"/></Control>
    <Control Id="Action" Type="Text" X="24" Y="168" Width="340" Height="40"><Subscribe Event="ActionText" Attribute="Text"/></Control>
   </Dialog>
   <Dialog Id="Completed" Width="390" Height="220" Title="SoleConfig 설치 완료">
    <Control Id="Title" Type="Text" X="24" Y="24" Width="340" Height="32" Text="{\Heading}설치가 완료되었습니다"/>
    <Control Id="Body" Type="Text" X="24" Y="70" Width="340" Height="30" Text="시작 메뉴에 SoleConfig가 추가되었습니다.&#13;&#10;마침을 누르면 선택한 작업을 진행합니다."/>
    <Control Id="Launch" Type="CheckBox" X="24" Y="119" Width="340" Height="20" Property="LAUNCHAPP" CheckBoxValue="1" Text="SoleConfig 실행"/>
    <Control Id="DefaultApps" Type="CheckBox" X="24" Y="149" Width="340" Height="20" Property="OPENDEFAULTAPPS" CheckBoxValue="1" Text="기본 프로그램 설정 (Windows 설정 열기)"/>
    <Control Id="Finish" Type="PushButton" X="306" Y="185" Width="65" Height="20" Default="yes" Cancel="yes" Text="마침">
     <Publish Event="DoAction" Value="LaunchApp" Condition="LAUNCHAPP = 1" Order="1"/>
     <Publish Event="DoAction" Value="OpenDefaultApps" Condition="OPENDEFAULTAPPS = 1" Order="2"/>
     <Publish Event="EndDialog" Value="Return" Order="3"/>
    </Control>
   </Dialog>
  </UI>
  <InstallUISequence>
   <Show Dialog="Welcome" Before="Installing" Condition="NOT Installed"/>
   <Show Dialog="Installing" Before="ExecuteAction"/>
   <Show Dialog="Completed" OnExit="success" Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot;"/>
   
   
  </InstallUISequence>
 </Package>
</Wix>
