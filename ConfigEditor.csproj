<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SoleConfig</AssemblyName>
    <Version>1.5.0</Version>
    <ApplicationIcon>Assets/Icon/SoleConfig.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="YamlDotNet" Version="18.1.0" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Fonts/Pretendard-Regular.ttf" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/ViewExamples/*.png" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Icon/SoleConfig.ico" /><Resource Include="Assets/Icon/SoleConfig-64.png" /></ItemGroup>
  <ItemGroup><Content Include="Python/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>





